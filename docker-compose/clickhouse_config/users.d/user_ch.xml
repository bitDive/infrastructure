<clickhouse>
    <users>
        <user_ch>
            <profile>low_mem</profile>
            <networks>
                <ip>::/0</ip>
            </networks>
            <password from_env="CLICKHOUSE_USER_PASSWORD" replace="replace" />
            <access_management>1</access_management>
            <named_collection_control>1</named_collection_control>
        </user_ch>

        <default>
            <password from_env="CLICKHOUSE_PASSWORD" replace="replace" />
            <access_management>1</access_management>
            <named_collection_control>1</named_collection_control>
        </default>
    </users>
</clickhouse>