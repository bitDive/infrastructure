FROM postgres:17.0

# Отключаем интерактивные подсказки debconf
ENV DEBIAN_FRONTEND=noninteractive

# (Опционально) чтобы debconf не ругался на отсутствие apt-utils
RUN apt-get update \
    && apt-get install -y --no-install-recommends apt-utils \
    && apt-get install -y \
       postgresql-17-cron \
       postgresql-plpython3-17 \
       python3-cryptography \
    && rm -rf /var/lib/apt/lists/*

# Включаем pg_cron и указываем базу
RUN echo "shared_preload_libraries = 'pg_cron'" \
      >> /etc/postgresql/postgresql.conf \
 && echo "cron.database_name = 'data-bitdive'" \
      >> /etc/postgresql/postgresql.conf