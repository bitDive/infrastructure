FROM postgres:17.0

# Disable interactive debconf prompts
ENV DEBIAN_FRONTEND=noninteractive

# (Optional) prevent debconf warnings about missing apt-utils
RUN apt-get update \
    && apt-get install -y --no-install-recommends apt-utils \
    && apt-get install -y \
       postgresql-17-cron \
       postgresql-plpython3-17 \
       postgresql-17-pgvector \
       python3-cryptography \
    && rm -rf /var/lib/apt/lists/*

# Enable pg_cron and specify the database
RUN echo "shared_preload_libraries = 'pg_cron'" \
      >> /etc/postgresql/postgresql.conf \
 && echo "cron.database_name = 'data-bitdive'" \
      >> /etc/postgresql/postgresql.conf